# Copy to .env.local (git-ignored) and fill in as needed.

# Target backend API URL (defaults to http://localhost:8080)
# Set to http://localhost:8081 (or custom port) when running multiple instances
VITE_API_BASE_URL=

# UUID of the user to show as signed in until login exists.
# Leave empty to use the System user seeded by backend migration V4.
# TODO(auth): remove once login exists (see src/vite-env.d.ts)
VITE_CURRENT_USER_ID=
