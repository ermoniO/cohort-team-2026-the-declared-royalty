# ==============================================================================
# Production Environment Configuration (Supabase Postgres + Supabase S3)
# ==============================================================================
# Copy this file to .env.prod (git-ignored) and fill in your production secrets:
#   cp .env.prod.example .env.prod
#
# Run production containers with:
#   docker compose --env-file .env.prod --profile prod up -d --build

COMPOSE_PROFILES=prod

# ==============================================================================
# Database (Supabase PostgreSQL)
# ==============================================================================
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=<your-supabase-db-password>
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ==============================================================================
# Object Storage (Supabase S3-Compatible Storage)
# ==============================================================================
BLOB_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
BLOB_ACCESS_KEY=<your-supabase-s3-access-key-id>
BLOB_SECRET_KEY=<your-supabase-s3-secret-access-key>
BLOB_REGION=us-east-1
BLOB_BUCKET=invoices

# ==============================================================================
# Application & External Services
# ==============================================================================
BACKEND_PORT=8080
FRONTEND_PROD_PORT=5173
FRONTEND_URL=https://your-frontend-domain.example.com
VITE_API_BASE_URL=https://your-api-domain.example.com

LLM_API_KEY=<your-llm-api-key>
MAX_QUERY_ATTEMPTS_PER_CALL=3

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

