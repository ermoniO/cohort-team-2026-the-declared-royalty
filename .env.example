# ==============================================================================
# Docker Compose & Application Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed for your local environment:
#   cp .env.example .env

# --- Compose Profile Selection ---
# Options:
#   - Leave empty to run only database/infrastructure containers (postgres, minio, pgadmin)
#   - Set to "dev" or "prod" to also run frontend in Docker
#   - Set to "backend,dev" to run full application stack in Docker
COMPOSE_PROFILES=

# --- PostgreSQL Configuration ---
POSTGRES_DB=invoice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- pgAdmin Configuration ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- MinIO Object Storage Configuration ---
MINIO_USER=minio_user
MINIO_PASSWORD=minio_password
MINIO_BUCKET=invoices

# --- LLM API Key (OpenRouter / OpenAI) ---
LLM_API_KEY=test-api-key

# ==============================================================================
# Port & Instance Configuration (Optional overrides for multi-instance testing)
# ==============================================================================
# Set COMPOSE_PROJECT_NAME to isolate container names when running side-by-side instances.
# COMPOSE_PROJECT_NAME=invoice-app-2
# BACKEND_PORT=8081
# FRONTEND_PORT=5174
# FRONTEND_PROD_PORT=5174
# POSTGRES_PORT=5433
# PGADMIN_PORT=5051
# MINIO_PORT=9050
# MINIO_CONSOLE_PORT=9051
# VITE_API_BASE_URL=http://localhost:8081
