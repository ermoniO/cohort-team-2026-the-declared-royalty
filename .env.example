# ==============================================================================
# Docker Compose & Application Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed for your local environment:
#   cp .env.example .env

# --- Compose Profile Selection ---
# Options:
#   - Leave empty to run only database/infrastructure containers (postgres, minio, pgadmin)
#   - Set to "dev" or "prod" to also run frontend in Docker
#   - Set to "backend,dev" to run full application stack in Docker
COMPOSE_PROFILES=

# --- PostgreSQL Configuration ---
POSTGRES_DB=invoice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- pgAdmin Configuration ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- MinIO Object Storage Configuration ---
MINIO_USER=minio_user
MINIO_PASSWORD=minio_password
MINIO_BUCKET=invoices

# --- LLM API Key (OpenRouter / OpenAI) ---
LLM_API_KEY=test-api-key

# ==============================================================================
# Multi-Branch Port Presets (Uncomment if running side-by-side with another branch)
# ==============================================================================
# --- Instance 2 (e.g. main-repo or second feature branch) ---
# COMPOSE_PROJECT_NAME=app-instance-2
# BACKEND_PORT=8081
# FRONTEND_PORT=5174
# FRONTEND_PROD_PORT=5174
# POSTGRES_PORT=5433
# PGADMIN_PORT=5051
# MINIO_PORT=9050
# MINIO_CONSOLE_PORT=9051
# VITE_API_BASE_URL=http://localhost:8081

# --- Instance 3 (e.g. reconciliation or staging) ---
# COMPOSE_PROJECT_NAME=app-instance-3
# BACKEND_PORT=8082
# FRONTEND_PORT=5175
# FRONTEND_PROD_PORT=5175
# POSTGRES_PORT=5434
# PGADMIN_PORT=5052
# MINIO_PORT=9060
# MINIO_CONSOLE_PORT=9061
# VITE_API_BASE_URL=http://localhost:8082
