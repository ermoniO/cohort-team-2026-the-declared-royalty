# ==============================================================================
# Docker Compose & Application Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed for your local environment:
#   cp .env.example .env

# --- Compose Profile Selection ---
# Leave empty (`docker compose up -d`) to run local infra only (postgres, minio, pgadmin)
# for running backend/frontend directly on your machine (IDE / mvnw / npm run dev).
#
# Common profiles:
#   - app      : Full dev stack in Docker (infra + backend + frontend-dev)
#   - backend  : Infra + containerized backend only
#   - frontend : Infra + containerized frontend-dev only
#   - prod     : Production backend-prod + frontend (point DB_*/BLOB_* at Supabase)
COMPOSE_PROFILES=

# ==============================================================================
# Database (Vendor-neutral: local Postgres in dev, Supabase in prod)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invoice_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/invoice_db

# ==============================================================================
# Object Storage (Vendor-neutral: MinIO in dev, Supabase S3 in prod)
# ==============================================================================
BLOB_ENDPOINT=http://localhost:9000
BLOB_ACCESS_KEY=minio_user
BLOB_SECRET_KEY=minio_password
BLOB_REGION=us-east-1
BLOB_BUCKET=invoices

# --- pgAdmin Configuration (local dev) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- LLM API Key (OpenRouter / OpenAI) ---
LLM_API_KEY=test-api-key
MAX_QUERY_ATTEMPTS_PER_CALL=3

# --- Stripe Configuration (Optional) ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ==============================================================================
# Multi-Branch Port Presets (Uncomment if running side-by-side with another branch)
# ==============================================================================
# --- Instance 2 (e.g. main-repo or second feature branch) ---
# COMPOSE_PROJECT_NAME=app-instance-2
# BACKEND_PORT=8081
# FRONTEND_PORT=5174
# FRONTEND_PROD_PORT=5174
# DB_PORT=5433
# PGADMIN_PORT=5051
# MINIO_PORT=9050
# MINIO_CONSOLE_PORT=9051

# --- Optional Frontend Overrides ---
# VITE_API_BASE_URL automatically defaults to http://localhost:${BACKEND_PORT:-8080}
# Set explicitly only if pointing frontend to a remote/external API.
# VITE_API_BASE_URL=http://localhost:8081
# UUID of user for mock login (leave empty to use seeded System user)
# VITE_CURRENT_USER_ID=

# --- Instance 3 (e.g. reconciliation or staging) ---
# COMPOSE_PROJECT_NAME=app-instance-3
# BACKEND_PORT=8082
# FRONTEND_PORT=5175
# FRONTEND_PROD_PORT=5175
# DB_PORT=5434
# PGADMIN_PORT=5052
# MINIO_PORT=9060
# MINIO_CONSOLE_PORT=9061
# VITE_API_BASE_URL=http://localhost:8082
