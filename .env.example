# ==============================================================================
# Docker Compose & Application Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed for your local environment:
#   cp .env.example .env

# --- Compose Profile Selection ---
# Options:
#   - Leave empty to run only database/infrastructure containers (postgres, minio, pgadmin)
#   - Set to "dev" or "prod" to also run frontend in Docker
#   - Set to "backend,dev" to run full application stack in Docker
COMPOSE_PROFILES=

# --- PostgreSQL Configuration ---
POSTGRES_DB=invoice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SUPABASE_DB="postgres"
SUPABASE_USER="postgres"
SUPABASE_PASSWORD="%9@h6-qRYd5I"
# SUPABASE_HOST="db.gkyiunhzmwbdckfoxait.supabase.co"
SUPABASE_URL="jdbc:postgresql://db.gkyiunhzmwbdckfoxait.supabase.co:5432/postgres?user=postgres&password=zJEfe61MnkKvEeg8qi3h"

# --- pgAdmin Configuration ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- MinIO Object Storage Configuration ---
MINIO_USER=minio_user
MINIO_PASSWORD=minio_password
MINIO_BUCKET=invoices
SUPABASE_S3_ENDPOINT="https://gkyiunhzmwbdckfoxait.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="us-east-1"
SUPABASE_S3_ACCESS_KEY_ID="f9241126cfccf5a89efe77749b1299b8"
